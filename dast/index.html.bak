<!DOCTYPE html>
<html lang="lt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DAST skenavimo registracija | Atakos vektorius</title>
    <meta name="description"
        content="Užsiregistruokite DAST (Dynamic Application Security Testing) skenavimui. Pateikite savo domeno vardą ir pasirinkite datą.">
    <meta name="robots" content="index, follow">
    <meta name="author" content="MB „Atakos vektorius“">
    <link rel="canonical" href="https://atakosvektorius.lt/dast/">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <meta property="og:title" content="DAST skenavimo registracija — Atakos vektorius">
    <meta property="og:description"
        content="Užsiregistruokite DAST skenavimui. Pateikite savo domeno vardą ir pasirinkite datą.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://atakosvektorius.lt/dast/">
    <meta property="og:site_name" content="Atakos vektorius">
    <meta property="og:locale" content="lt_LT">
    <meta property="og:image" content="https://atakosvektorius.lt/atakos_vektorius_logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/style.css?v=7">
    <!-- Cloudflare Turnstile Script -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "DAST pažeidžiamumų skenavimas",
      "provider": {
        "@type": "ProfessionalService",
        "@id": "https://atakosvektorius.lt/#organization",
        "name": "MB „Atakos vektorius“"
      },
      "serviceType": "Dynamic Application Security Testing",
      "description": "Nemokamas DAST skenavimas domeno pažeidžiamumams ir saugumo spragoms nustatyti.",
      "url": "https://atakosvektorius.lt/dast/"
    }

        // Pagalbinės funkcijos domeno verifikacijai
        function copyDastField(inputId, btnEl) {
            var input = document.getElementById(inputId);
            if (!input) return;
            navigator.clipboard.writeText(input.value);
            var origText = btnEl.innerText;
            btnEl.innerText = 'Nukopijuota! ✓';
            btnEl.style.color = '#047857';
            setTimeout(function () {
                btnEl.innerText = origText;
                btnEl.style.color = '';
            }, 1800);
        }

        async function startCloudflareConnect() {
            if (!window._dastVerification || !window._dastVerification.domain) return;

            var statusEl = document.getElementById('cf-oauth-status');
            var btn = document.getElementById('btn-cf-connect');
            statusEl.style.display = 'block';
            statusEl.style.color = '#c2410c';
            statusEl.innerHTML = 'Jungiamasi prie Cloudflare...';
            btn.disabled = true;

            try {
                var res = await fetch('/api/auth/cloudflare/authorize-url?domain=' + encodeURIComponent(window._dastVerification.domain));
                var data = await res.json();
                if (!res.ok || !data.authUrl) throw new Error(data.error || 'Nepavyko pradėti autorizacijos');

                window._dastVerification.stateToken = data.state;
                window._dastVerification.codeVerifier = data.codeVerifier;

                var w = 600, h = 720;
                var left = (window.screenX || window.screenLeft || 0) + (window.outerWidth - w) / 2;
                var top = (window.screenY || window.screenTop || 0) + (window.outerHeight - h) / 2;

                window.open(data.authUrl, 'cf_oauth_popup', 'width=' + w + ',height=' + h + ',top=' + top + ',left=' + left + ',status=no,menubar=no');
            } catch (err) {
                statusEl.style.color = '#b91c1c';
                statusEl.innerText = 'Klaida: ' + err.message;
                btn.disabled = false;
            }
        }

        window.addEventListener('message', async function (event) {
            if (!event.data || event.data.type !== 'CLOUDFLARE_OAUTH_RESPONSE') return;
            var payload = event.data;
            var statusEl = document.getElementById('cf-oauth-status');
            var btn = document.getElementById('btn-cf-connect');

            if (payload.error) {
                statusEl.style.color = '#b91c1c';
                statusEl.innerText = 'Autorizacija atmesta: ' + (payload.errorDescription || payload.error);
                btn.disabled = false;
                return;
            }

            statusEl.style.color = '#2563eb';
            statusEl.innerHTML = 'Kuriame DNS TXT įrašą Jūsų zonoje...';

            try {
                var res = await fetch('/api/auth/cloudflare/callback', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        code: payload.code,
                        state: payload.state || window._dastVerification.stateToken,
                        codeVerifier: window._dastVerification.codeVerifier,
                        domain: window._dastVerification.domain,
                        txtRecordValue: window._dastVerification.txtValue
                    })
                });

                var result = await res.json();
                if (res.ok && result.success) {
                    statusEl.style.color = '#15803d';
                    statusEl.innerHTML = '<strong>✓ Domenas sėkmingai patvirtintas per Cloudflare! 🚀</strong>';
                    btn.style.background = '#15803d';
                    btn.innerText = '✓ Patvirtinta per Cloudflare';
                } else {
                    throw new Error(result.error || 'Nepavyko sukurti DNS įrašo');
                }
            } catch (err) {
                statusEl.style.color = '#b91c1c';
                statusEl.innerText = 'Klaida: ' + err.message;
                btn.disabled = false;
            }
        });

        async function verifyDastManual() {
            if (!window._dastVerification || !window._dastVerification.domain) return;
            var statusEl = document.getElementById('manual-verify-status');
            var btn = document.getElementById('btn-manual-verify');

            statusEl.style.display = 'block';
            statusEl.style.color = '#4b5563';
            statusEl.innerText = 'Tikrinama DNS propagacija...';
            btn.disabled = true;

            try {
                var res = await fetch('/api/dast/verify-domain', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        domain: window._dastVerification.domain,
                        expectedValue: window._dastVerification.txtValue
                    })
                });
                var data = await res.json();
                if (data.verified) {
                    statusEl.style.color = '#15803d';
                    statusEl.innerHTML = '<strong>✓ TXT įrašas rastas ir patvirtintas!</strong>';
                } else {
                    statusEl.style.color = '#b91c1c';
                    statusEl.innerText = 'TXT įrašas dar neaptiktas. Palaukite 1-2 min. ir bandykite vėl.';
                }
            } catch (err) {
                statusEl.style.color = '#b91c1c';
                statusEl.innerText = 'Tinklo klaida tikrinant DNS.';
            } finally {
                btn.disabled = false;
            }
        }
    </script>

    <!-- Pre-consent: dataLayer + gtag stub + consent defaults (Consent Mode v2) -->
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        gtag('consent', 'default', {
            'ad_storage': 'denied',
            'analytics_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied',
            'wait_for_update': 500
        });
        gtag('js', new Date());
    </script>

    <!-- Užkraunama tik po analytics sutikimo iš PIRMOSIOS ŠALIES domain'o (per Google Tag Gateway) -->
    <script type="text/plain" data-cookiecategory="analytics" async src="/okp0/gtag/js?id=G-MM3XFZX1JX"></script>
    <script type="text/plain" data-cookiecategory="analytics">
        gtag('config', 'G-MM3XFZX1JX', {
            transport_url: 'https://atakosvektorius.lt/okp0',
            first_party_collection: true
        });

